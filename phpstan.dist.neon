parameters:
    level: 10
    phpVersion:
        min: 80200
        max: 80599
    paths:
        - private
        - public
    excludePaths:
        # The front controller brings the view variables into scope with
        # extract() before including a template, so analysing templates on
        # their own only yields structural noise.
        - private/template
    bootstrapFiles:
        - private/bootstrap.php
    # Deployment/instance configuration: fixed at analysis time but variable
    # across installs, so their values must not be constant-folded.
    dynamicConstantNames:
        - BASE
        - VERSION
        - DB_HOST
        - DB_PORT
        - DB_NAME
        - DB_USER
        - DB_PASS
        - DB_SSL_CA_FILE
        - DB_SSL_ENABLED
        - DB_SSL_VERIFY_CERT
        - DEBUG
        - PAGE_SIZE
        - CLOUD_SIZE
        - TAGS_PAGE_SIZE
