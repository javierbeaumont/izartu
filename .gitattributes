# A release download can name the source it came from without any build step.
VERSION export-subst

# And carries the deployable tree only.
# `/*` matches the root only: everything under private/ and public/ ships.
/* export-ignore
/CODE_OF_CONDUCT.md -export-ignore
/CONTRIBUTING.md -export-ignore
/LICENSE -export-ignore
/README.md -export-ignore
/SECURITY.md -export-ignore
/VERSION -export-ignore
/private -export-ignore
/public -export-ignore
